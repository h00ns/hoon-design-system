---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<figure class="ds-dodont__item" data-tone="do">
  <figcaption class="ds-dodont__title">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.86a.75.75 0 0 0-1.22-.88l-3.4 4.7-1.74-1.74a.75.75 0 1 0-1.06 1.06l2.36 2.36a.75.75 0 0 0 1.14-.09l3.92-5.41Z"
      ></path>
    </svg>
    <span>이렇게{title && ` — ${title}`}</span>
  </figcaption>
  <div><slot /></div>
</figure>
