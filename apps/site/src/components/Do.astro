---
import { CheckCircle } from '@phosphor-icons/react/ssr';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<figure class="ds-dodont__item" data-tone="do">
  <figcaption class="ds-dodont__title">
    <CheckCircle size={18} weight="fill" aria-hidden="true" />
    <span class="ds-dodont__label">권장</span>
    {title && <span>{title}</span>}
  </figcaption>
  <div><slot /></div>
</figure>
