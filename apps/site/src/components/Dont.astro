---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<figure class="ds-guide" data-tone="dont">
  <figcaption class="ds-guide__head">
    <span class="ds-guide__label">피하기</span>
    {title && <span class="ds-guide__title">{title}</span>}
  </figcaption>
  <div class="ds-guide__body"><slot /></div>
</figure>
