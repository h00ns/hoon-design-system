---
/**
 * 페이지 머리말: 분류 · 제목 · 요약(description) · 참고 링크 배지.
 * 컴포넌트 페이지는 src/data/components.ts 의 메타데이터로 배지를 만든다.
 */
import { ArrowUpRight } from '@phosphor-icons/react/ssr';
import { findComponent } from '../../data/components';

const { entry, id } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const section = id.split('/')[0] ?? '';
const SECTION_LABEL: Record<string, string> = {
  'getting-started': '시작하기',
  foundations: 'Foundations',
  components: 'Components',
};
const slug = id.split('/')[1];
const meta = section === 'components' && slug ? findComponent(slug) : undefined;
const source = meta
  ? `https://github.com/h00ns/hoon-design-system/tree/main/packages/react/src/${meta.slug}`
  : undefined;
const links = [
  meta?.apg && { label: 'WAI-ARIA 패턴', href: meta.apg },
  meta?.radix && { label: 'Radix 프리미티브', href: meta.radix },
  source && { label: '소스 코드', href: source },
].filter(Boolean) as { label: string; href: string }[];
---

<header class="ds-page-title">
  {
    SECTION_LABEL[section] && (
      <p class="ds-page-title__section">
        {SECTION_LABEL[section]}
        {meta && <span class="ds-page-title__category">{meta.category}</span>}
      </p>
    )
  }
  <h1 id="_top">{title}</h1>
  {description && <p class="ds-page-title__lead">{description}</p>}
  {
    links.length > 0 && (
      <ul class="ds-page-title__links" aria-label="참고 링크">
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noreferrer">
              {l.label}
              <ArrowUpRight size={14} weight="bold" aria-hidden="true" />
              <span class="sr-only">(새 창)</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</header>
