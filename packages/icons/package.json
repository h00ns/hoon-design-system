{
  "name": "@hoon-ds/icons",
  "version": "0.0.0",
  "description": "Accessible, tree-shakable icons for hoon-design-system (React components + raw SVG)",
  "keywords": [
    "icons",
    "svg",
    "react",
    "design-system",
    "accessibility"
  ],
  "license": "MIT",
  "homepage": "https://h00ns.github.io/hoon-design-system/foundations/icons/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h00ns/hoon-design-system.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/h00ns/hoon-design-system/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./meta": {
      "import": {
        "types": "./dist/meta.d.ts",
        "default": "./dist/meta.js"
      },
      "require": {
        "types": "./dist/meta.d.cts",
        "default": "./dist/meta.cjs"
      }
    },
    "./svg/*": "./svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "svg"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsdown",
    "test": "node scripts/generate.mjs && vitest run",
    "typecheck": "node scripts/generate.mjs && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
