{
  "name": "@hoon-ds/react",
  "version": "0.1.0",
  "description": "Accessible React components for hoon-design-system, built on Radix",
  "keywords": [
    "react",
    "components",
    "design-system",
    "accessibility",
    "a11y",
    "radix"
  ],
  "license": "MIT",
  "homepage": "https://h00ns.github.io/hoon-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h00ns/hoon-design-system.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/h00ns/hoon-design-system/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@hoon-ds/css": "workspace:^",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
