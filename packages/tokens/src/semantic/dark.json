{
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "{color.gray.950}" },
      "subtle": { "$value": "{color.gray.900}" },
      "muted": { "$value": "{color.gray.800}" },
      "inverse": { "$value": "{color.gray.50}" },
      "overlay": { "$value": "#000000b8" }
    },
    "fg": {
      "default": { "$value": "{color.gray.50}" },
      "muted": { "$value": "{color.gray.400}" },
      "disabled": { "$value": "{color.gray.600}" },
      "inverse": { "$value": "{color.gray.900}" },
      "on-accent": { "$value": "{color.white}" },
      "on-warning": { "$value": "{color.gray.950}" }
    },
    "border": {
      "default": { "$value": "{color.gray.800}" },
      "control": { "$value": "{color.gray.500}" }
    },
    "accent": {
      "solid": { "$value": "{color.blue.600}" },
      "solid-hover": { "$value": "{color.blue.700}" },
      "solid-active": { "$value": "{color.blue.800}" },
      "fg": { "$value": "{color.blue.300}" },
      "subtle": { "$value": "{color.blue.950}" },
      "subtle-hover": { "$value": "{color.blue.900}" }
    },
    "danger": {
      "solid": { "$value": "{color.red.600}" },
      "solid-hover": { "$value": "{color.red.700}" },
      "solid-active": { "$value": "{color.red.800}" },
      "fg": { "$value": "{color.red.300}" },
      "subtle": { "$value": "{color.red.950}" }
    },
    "success": {
      "solid": { "$value": "{color.green.700}" },
      "fg": { "$value": "{color.green.300}" },
      "subtle": { "$value": "{color.green.950}" }
    },
    "warning": {
      "solid": { "$value": "{color.amber.400}" },
      "fg": { "$value": "{color.amber.300}" },
      "subtle": { "$value": "{color.amber.950}" }
    },
    "neutral": {
      "subtle": { "$value": "{color.gray.800}" },
      "subtle-hover": { "$value": "{color.gray.700}" },
      "subtle-active": { "$value": "{color.gray.600}" }
    },
    "focus-ring": { "$value": "{color.blue.400}" }
  }
}
